static inline uint16_t linearTransformation(uint16_t raw_data, uint16_t min_raw_data, uint16_t min_real_value, uint32_t correction_factor)
{
	return (((raw_data - min_raw_data)*correction_factor >> 12))+ min_real_value;
}
