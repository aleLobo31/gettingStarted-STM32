//We use this interruption to handle commands that are received from CAN.
void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef* hcan) {

  if (HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0, &RxHeader, RxData) != HAL_OK) {
    /* Reception Error */
    Error_Handler();
  }

  switch (RxData[0]) {

  case 0xAA: // start calibration command
    enter_calibration_mode = 1;
    abort_calibration = 0;
    calibration_config.enable_calib_steering = RxData[1] == 0xAA ? 1 : 0;
    calibration_config.enable_calib_damper_left = RxData[2] == 0xAA ? 1 : 0;
    calibration_config.enable_calib_damper_right = RxData[3] == 0xAA ? 1 : 0;
    break;

  case 0xAB: // end calibration command
    enter_calibration_mode = 0;
    abort_calibration = 0;
    break;

  case 0xAC: // abort calibration command
    enter_calibration_mode = 0;
    abort_calibration = 1;
    calibration_config.enable_calib_steering = 0;
    calibration_config.enable_calib_damper_left = 0;
    calibration_config.enable_calib_damper_right = 0;
    break;
    // add more commands here if needed
  }
}
